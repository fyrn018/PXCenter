{
  "version": 2,
  "regions": ["sin1"],
  "builds": [
    {
      "src": "index.js",
      "use": "@vercel/node",
      "config": {
        "maxDuration": 300,
        "includeFiles": [
          "dist/**",
          "node_modules/systeminformation/**",
          "node_modules/@grpc/**",
          "node_modules/axios/**",
          "node_modules/ws/**"
        ]
      }
    }
  ],
  "routes": [
    { "src": "/(.*)", "dest": "index.js" }
  ]
}
